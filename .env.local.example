# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_MANAGEMENT_TOKEN=your-supabase-management-token

# Admin password (hardcoded simple auth)
ADMIN_PASSWORD=admin1234

# Public site URL (used for absolute links, e.g. in SMS/emails)
NEXT_PUBLIC_BASE_URL=https://lottomn.vercel.app

# CallPro Text SMS (https://api-text.callpro.mn)
CALLPRO_API_KEY=your-callpro-api-key
CALLPRO_SENDER=72229670

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
